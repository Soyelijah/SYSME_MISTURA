<TfrxReport Version="4.0.11" DotMatrixReport="False" EngineOptions.MaxMemSize="10000000" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="37989,8660770833" ReportOptions.Description.Text="" ReportOptions.LastChange="44249,4683602778" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo19OnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;       if SUM(&#60;Detalle1x.&#34;pvptiquet&#34;&#62;*&#60;Detalle1x.&#34;cantidad&#34;&#62;*(&#60;Detalle1x.&#34;descuento&#34;&#62;/100),DetailData1) = 0 then&#13;&#10;               begin&#13;&#10;               Memo19.visible:=false;&#13;&#10;               Memo40.visible:=false;&#13;&#10;               end;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo47OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    if &#60;Detalle4x.&#34;importe&#34;&#62; &#62; 0 then&#13;&#10;       begin&#13;&#10;       Memo47.memo.text:='Entregado';&#13;&#10;       end&#13;&#10;    else&#13;&#10;       begin&#13;&#10;       Memo47.memo.text:='Cambio';&#13;&#10;       end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo28OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    if &#60;Detalle1x.&#34;descuento&#34;&#62; &#60;= 0 then&#13;&#10;       begin&#13;&#10;       Memo28.visible:=false;&#13;&#10;       end&#13;&#10;    else&#13;&#10;       begin&#13;&#10;       Memo28.visible:=true;&#13;&#10;       end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;cadena: string;&#13;&#10;begin&#13;&#10;  cadena:=&#60;Detalle1x.&#34;complementog&#34;&#62;;&#13;&#10;  cadena:=cadena[1]+cadena[2]+cadena[3];&#13;&#10;  if (&#60;Detalle1x.&#34;precio&#34;&#62; = 0) and (cadena = '--&#62;' ) then&#13;&#10;       begin&#13;&#10;       DetailData1.visible:=false;&#13;&#10;       end&#13;&#10;  else&#13;&#10;       begin&#13;&#10;       DetailData1.visible:=true;&#13;&#10;       end;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
